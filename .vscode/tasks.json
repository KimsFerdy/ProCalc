{
  // Ctrl+Shift+B runs the app. Other tasks: Ctrl+Shift+P → "Tasks: Run Task".
  // On Windows the tasks run through cmd, so PowerShell's script policy never gets in the way.
  "version": "2.0.0",
  "windows": {
    "options": {
      "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] }
    }
  },
  "tasks": [
    {
      "label": "ProCalc: run app",
      "detail": "tauri dev: rebuilds Rust and reloads the UI as you save",
      "type": "shell",
      "command": "npm run tauri dev",
      "group": { "kind": "build", "isDefault": true },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "ProCalc: fix broken build",
      "detail": "Linker errors full of 'unresolved external symbol anon…llvm': clear the engine and app build caches",
      "type": "shell",
      "command": "cargo clean -p procalc-engine && cargo clean -p procalc",
      "problemMatcher": []
    },
    {
      "label": "ProCalc: engine tests",
      "type": "shell",
      "command": "cargo test -p procalc-engine",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "ProCalc: stress test",
      "detail": "Runs stress/corpus.txt; the listing goes to stress/report.md",
      "type": "shell",
      "command": "cargo run -p procalc-engine --example stress",
      "problemMatcher": []
    },
    {
      "label": "ProCalc: check everything",
      "detail": "Feature map, Svelte types, clippy",
      "type": "shell",
      "command": "bash scripts/check-features.sh && npm run check && cargo clippy --workspace --all-targets",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "ui:dev",
      "detail": "The Vite dev server on its own (used by the debugger)",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^x" },
        "background": { "activesBegin": ".", "beginsPattern": "VITE", "endsPattern": "Local:" }
      }
    },
    {
      "label": "rust:build app",
      "type": "shell",
      "command": "cargo build -p procalc",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "debug: prepare",
      "detail": "Used by F5: the UI server plus a fresh debug build",
      "dependsOn": ["ui:dev", "rust:build app"],
      "dependsOrder": "parallel"
    }
  ]
}
