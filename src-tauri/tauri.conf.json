{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProCalc",
  "version": "0.1.0",
  "identifier": "dev.kimsferdinand.procalc",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "ProCalc",
        "width": 1040,
        "height": 780,
        "minWidth": 380,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5QUQwNDNFMDZDMDM0NzAKUldSd05NQUdQZ1N0aWZGSG9XWUVsbXdHSlhhaEhhb1VxenhtL0szanRsa056UGpya2g4dVdNR2sK",
      "endpoints": [
        "https://github.com/KimsFerdy/ProCalc/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
